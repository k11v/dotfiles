#!/usr/bin/env python3

import urllib.parse
import json
import base64
import sys


def parse_single_vless(tag, vless_url):
    url = vless_url[len("vless://") :]
    user_host, _, rest = url.partition("@")
    host_port, _, query_fragment = rest.partition("?")
    query, _, fragment = query_fragment.partition("#")
    user_id = user_host
    host, _, port = host_port.partition(":")

    params = urllib.parse.parse_qs(query)
    params = {k: v[0] for k, v in params.items()}

    server_name = params.get("sni", "")

    frag_parts = fragment.split("&")
    public_key = None
    short_id = ""
    for part in frag_parts:
        if part.startswith("pbk="):
            public_key = part[4:]
        elif part.startswith("sid="):
            short_id = part[4:]

    outbound_config = {
        "tag": tag,
        "protocol": "vless",
        "settings": {
            "vnext": [
                {
                    "address": host,
                    "port": int(port),
                    "users": [
                        {
                            "id": user_id,
                            "encryption": params.get("encryption", "none"),
                            "flow": params.get("flow"),
                        }
                    ],
                }
            ]
        },
        "streamSettings": {},
    }

    match params.get("type"):
        case "tcp":
            outbound_config["streamSettings"]["network"] = "tcp"
        case "ws":
            outbound_config["streamSettings"]["network"] = "websocket"
            outbound_config["streamSettings"]["wsSettings"] = {
                "host": params.get("host"),
                "path": params.get("path"),
            }
        case v:
            assert False, f"unknown type: {v}"

    match params.get("security"):
        case "reality":
            outbound_config["streamSettings"]["security"] = "reality"
            outbound_config["streamSettings"]["realitySettings"] = {
                "fingerprint": params.get("fp"),
                "serverName": server_name,
                "publicKey": public_key,
                "shortId": short_id,
            }
        case "tls":
            outbound_config["streamSettings"]["security"] = "tls"
            outbound_config["streamSettings"]["tlsSettings"] = {
                "fingerprint": params.get("fp"),
                "serverName": server_name,
            }
        case v:
            assert False, f"unknown security: {v}"

    config = {
        "log": {"loglevel": "warning"},
        "inbounds": [
            {
                "port": 10808,
                "listen": "127.0.0.1",
                "protocol": "socks",
                "settings": {"udp": True},
            }
        ],
        "outbounds": [
            outbound_config,
        ],
    }

    return config


def main():
    tag = sys.argv[1] if len(sys.argv) > 1 else None
    source = sys.stdin.read().strip()

    if source.startswith("vless://"):
        config = parse_single_vless(tag, source)
    else:
        raise ValueError("Unsupported input data format")

    config_json = json.dumps(config, indent=4)
    sys.stdout.write(config_json)


if __name__ == "__main__":
    main()
