#!/usr/bin/env zsh

() {
	git \
		-c core.attributesFile="$1" \
		-c diff.quiet.textconv='git hash-object' \
		"${@:2}"
} =(
	# See /system/doc/mock.md.
	printf '%s\n' \
		'**/mock/**/*.go diff=quiet' \
		'**/mocks/**/*.go diff=quiet' \
		'**/generated/**/*.go diff=quiet' \
		'**/*_mock.go diff=quiet' \
		'**/mock_*.go diff=quiet'
) "$@"
