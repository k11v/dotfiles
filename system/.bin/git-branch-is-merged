#!/bin/bash

set -euo pipefail

dst_branch="$1"
[[ -z "$dst_branch" ]] && { echo "error: empty dst branch" >&2; exit 1; }
src_branch="$2"
[[ -z "$src_branch" ]] && { echo "error: empty src branch" >&2; exit 1; }
merge_base="$(git merge-base "$dst_branch" "$src_branch")" || :
[[ -z "$merge_base" ]] && { echo "error: empty merge base" >&2; exit 1; }

# Prints the newest dst commit whose patch matches one in the given rev.
dst_commit() {
	git cherry "$1" "$dst_branch" | sed -n 's/^- //p' | tail -1
}

# Checks commit identity (SHAs). Quickly detects merged and fast-forwarded.
if git merge-base --is-ancestor "$src_branch" "$dst_branch"; then
	src_commit="$(git rev-parse "$src_branch")"
	if [[ "$(git rev-list --first-parent "$dst_branch" --not "$src_commit^@" | tail -1)" == "$src_commit" ]]; then
		echo "fast-forwarded $src_commit"
		exit 0
	fi
	echo "merged $(git rev-list --merges --ancestry-path "$src_branch".."$dst_branch" | tail -1)"
	exit 0
fi

# Checks commit content (patch-ids). Detects merged, fast-forwarded, rebased and cherry-picked. False detects same patch merges.
cherry="$(git cherry "$dst_branch" "$src_branch")"
if [[ "$cherry" != *+* ]]; then
	commit="$(dst_commit "$src_branch")"
	echo "rebased or cherry-picked${commit:+ $commit}"
	exit 0
fi

# Checks combined diff as one patch. Detects squashed. False detects same patch merges. Creates dangling commits.
squash_commit="$(git commit-tree "$src_branch^{tree}" -p "$merge_base" -m squash)"
if [[ "$(git cherry "$dst_branch" "$squash_commit")" != *+* ]]; then
	commit="$(dst_commit "$squash_commit")"
	echo "squashed${commit:+ $commit}"
	exit 0
fi

echo "not merged"
exit 1
