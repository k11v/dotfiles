#!/bin/sh
#
# nvim-treesitter-parser-install <language> <url> <branch>
#
# Program needs:
# - tree-sitter (brew install tree-sitter-cli)
# - C compiler
#
# Note:
# - Parsers generated by the tree-sitter CLI aren't always backwards compatible.
#   If you need a parser, generate it yourself using the CLI; all the information to do so is available in this package.
#   By doing that, you'll also know for sure that your parser version and your library version are compatible.

set -eu

# Process arguments.

language="$1"
if [ -z "$language" ]; then
	echo "error: empty language" >&2
	exit 1
fi

url="$2"
if [ -z "$url" ]; then
	echo "error: empty url" >&2
	exit 1
fi

branch="$3"
if [ -z "$branch" ]; then
	echo "error: empty branch" >&2
	exit 1
fi

# Prepare repository.

cache_dir="$HOME/.cache/nvim-treesitter-parser-install"
repository_name="$(
	printf '%s-%s' \
		"$(printf '%s' "$url" | sed 's|/$||' | sed 's|^.*/||' | tr -c 'A-Za-z0-9._-' '-')" \
		"$(printf '%s' "$url" | sha256sum | cut -c1-16)"
)"
repository_dir="$cache_dir/$repository_name"

mkdir -p "$cache_dir"
test ! -e "$repository_dir" && git clone "$url" "$repository_dir" || git -C "$repository_dir" fetch --all --tags --prune --prune-tags
git -C "$repository_dir" checkout .
git -C "$repository_dir" checkout "$branch"
git -C "$repository_dir" symbolic-ref -q HEAD && git -C "$repository_dir" merge --ff-only @{u}
printf "prepared repository: %s\n" "$repository_dir"

# Prepare parser.

parser_file="$repository_dir/parser.so"

(
	cd "$repository_dir"
	tree-sitter generate
	tree-sitter build -o "$parser_file"
	printf "prepared parser: %s\n" "$parser_file"
)

# Install library.

nvim_parser_dir="$HOME/.local/share/nvim/site/parser"
nvim_parser_file="$nvim_parser_dir/$language.so"

mkdir -p "$nvim_parser_dir"
rm -f "$nvim_parser_file"
ln -s "$parser_file" "$nvim_parser_file"
printf "installed parser: %s\n" "$nvim_parser_file"
