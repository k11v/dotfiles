{
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "port": 1080,
            "protocol": "socks",
            "settings": {
                "udp": true,
                "userLevel": 0
            },
            "sniffing": {
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "enabled": true,
                "routeOnly": true
            }
        },
        {
            "listen": "127.0.0.1",
            "port": 1081,
            "protocol": "http",
            "settings": {
                "userLevel": 0
            },
            "sniffing": {
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "enabled": true,
                "routeOnly": true
            }
        }
    ],
    "log": {
        "loglevel": "warning"
    },
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "vless.example.com",
                        "port": 443,
                        "users": [
                            {
                                "encryption": "none",
                                "flow": "",
                                "id": "00000000-0000-4000-8000-000000000000"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "websocket",
                "security": "tls",
                "tlsSettings": {
                    "fingerprint": "firefox",
                    "serverName": "tls.example.com"
                },
                "wsSettings": {
                    "host": "cdn.example.com",
                    "path": "/proxy"
                }
            },
            "tag": "custom-proxy"
        },
        {
            "protocol": "freedom",
            "settings": {},
            "tag": "direct"
        }
    ],
    "routing": {
        "domainStrategy": "IPOnDemand",
        "rules": [
            {
                "outboundTag": "direct",
                "protocol": [
                    "bittorrent"
                ],
                "type": "field"
            },
            {
                "domain": [
                    "geosite:private",
                    "geosite:category-ru"
                ],
                "outboundTag": "direct",
                "type": "field"
            },
            {
                "ip": [
                    "geoip:private",
                    "geoip:ru"
                ],
                "outboundTag": "direct",
                "type": "field"
            },
            {
                "network": "tcp,udp",
                "outboundTag": "custom-proxy",
                "type": "field"
            }
        ]
    }
}
